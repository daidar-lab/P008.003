# PostgreSQL — a aplicação roda contra a database que você apontar aqui.
# Por padrão usamos a database "postgres" (que já vem criada em toda
# instalação). Ajuste para a sua instância.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Alternativa por variáveis individuais (só usadas se DATABASE_URL
# não estiver definida).
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=postgres

# API
PORT=3001
CORS_ORIGIN=http://localhost:5173
